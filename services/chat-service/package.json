{
  "name": "easybake-chat-service",
  "version": "1.0.0",
  "description": "EasyBake community chat service - Node.js WebSocket server with Socket.IO and TypeScript.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=src/tests/unit",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "postinstall": "npx prisma generate"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/internals": "^7.10.1",
    "@supabase/supabase-js": "^2.99.2",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "pg": "^8.20.0",
    "prisma": "^7.10.1",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.17",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.74.0"
  }
}
