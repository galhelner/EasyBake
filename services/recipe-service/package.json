{
  "name": "easybake-recipe-service",
  "version": "1.0.0",
  "description": "EasyBake recipe service - Node.js Express API with TypeScript, Prisma, and Supabase auth.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "token": "ts-node-dev --transpile-only --exit-child src/scripts/getToken.ts",
    "ingredients:load": "ts-node src/scripts/loadIngredientsArchive.ts",
    "build": "tsc",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=src/tests/unit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.99.2",
    "axios": "^1.21.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.15",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.74.0"
  }
}
